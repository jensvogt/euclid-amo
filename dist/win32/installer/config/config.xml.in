<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>EuclidAMO</Name>
    <Version>@VERSION_STRING@</Version>
    <Title>Euclid Application Monitoring Installer</Title>
    <Publisher>Dr. Jens Vogt</Publisher>
    <!--
        Branding for the two binaries IFW itself produces - the installer, and the maintenance tool
        it leaves behind in TargetDir for uninstall and "check for updates". Without these both
        carry IFW's stock icon, so the thing sitting in Add/Remove Programs looks unrelated to the
        application it manages.

        InstallerApplicationIcon is deliberately extension-less: IFW appends the platform's own
        (.ico on Windows, .png on Linux, .icns on macOS). Both euclid-amo.ico and euclid-amo.png sit
        next to this file, copied there at configure time by CMakeLists.txt from the single sources
        under dist/win32 and dist/branding, so the installer icon cannot drift from the one compiled
        into euclid-amo.exe. Paths are resolved relative to this file's directory.
    -->
    <InstallerApplicationIcon>euclid-amo</InstallerApplicationIcon>
    <InstallerWindowIcon>euclid-amo.png</InstallerWindowIcon>
    <StartMenuDir>euclid</StartMenuDir>
    <!--
        C:\Program Files\euclid-amo.

        @ApplicationsDirX64@ rather than the literal path: it is the same directory on a stock
        machine, but stays correct where Program Files is not on C: or is localized. And rather
        than plain @ApplicationsDir@, which it used to be, because @ApplicationsDir@ resolves per
        the *installer's* bitness - and the installerbase in tools_ifw is a 32-bit binary, so
        WOW64 redirection silently landed it in "C:\Program Files (x86)" despite the app itself
        being x64. The X64 form is fixed regardless of which installerbase carries it.

        Program Files is not writable by a normal user, so installerbase prompts for elevation
        before copying (its standard authorization fallback - left on, i.e. no
        DisableAuthorizationFallback here). One consequence worth knowing: once elevated, the
        shortcuts installscript.qs creates land in the all-users Start menu and on the all-users
        desktop rather than the installing user's own.
    -->
    <TargetDir>@ApplicationsDirX64@/euclid-amo</TargetDir>
    <RemoteRepositories>
        <Repository>
            <Url>https://jensvogt.github.io/euclid-amo</Url>
            <Enabled>true</Enabled>
        </Repository>
    </RemoteRepositories>
</Installer>
